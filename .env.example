# 环境变量模板
#
# 用法：cp .env.example .env，然后按需改。
# .env 已在 .gitignore 里，**绝不会**入库；本文件（模板）要入库。
#
# 为什么用 .env 而不是把配置写死在 config.py 里：
#   同一份代码要在两种环境下跑，broker 地址完全不同——
#     本机开发（uvicorn 直跑）→ broker 是 WSL 里 Docker 发布的端口，用 localhost
#     容器里跑             → backend 和 mosquitto 在同一 docker 网络，用服务名 mosquitto
#   写死的话就得改代码。而且 broker 密码属于凭据，不该进代码库。

# ── MQTT broker ─────────────────────────────────────────────────
# ★ 本机开发用 localhost；容器里跑必须改成 mosquitto。
#   "容器里的 localhost 是容器自己"，这是最常见的配置错误，
#   症状是连接被拒绝，而 broker 明明在跑。
MQTT_HOST=localhost
MQTT_PORT=1883

# 开发阶段 Mosquitto 是 allow_anonymous true，这两项留空即可。
# 正式部署（文档 §39）再加用户名密码。
MQTT_USERNAME=
MQTT_PASSWORD=

# ★ client_id 必须在 broker 上唯一。
#   两个实例用同一个 client_id 会互相踢下线，表现是双方轮流掉线、
#   日志里只有语焉不详的 DISCONNECTED。所以：
#     - uvicorn 必须 --workers 1（多 worker = 多个实例共用一个 id）
#     - 临时起第二个实例调试时，记得把这里改掉
MQTT_CLIENT_ID=iot-backend-dev

# 订阅的 topic。`+` 是 MQTT 的单层通配符，
# 所以 iot/+/telemetry 能匹配所有设备的遥测，将来多设备不用改配置。
MQTT_TOPIC_TELEMETRY=iot/+/telemetry
MQTT_TOPIC_STATUS=iot/+/status
MQTT_QOS=1

# ── 数据库 ──────────────────────────────────────────────────────
# ★ sqlite:// 后面是**四个**斜杠：前两个是 URL 的 scheme 分隔符，
#   第三个是"路径从这里开始"，第四个才是绝对路径的第一个 '/'。
#   写成三个斜杠会被当成相对路径，库文件会落到当前工作目录。
#
# ★ 绝对不要把库放在 /mnt/c 下面。
#   /mnt/c 是 DrvFs（9p 文件系统），WAL 依赖的 -shm 共享内存映射
#   在它上面支持不完整，症状是"明明没有并发却报 database is locked"，
#   而且开发早期不会出现，等你把数据看得比较重了才炸。
#   所以放在 WSL 自己的文件系统里（ext4）。
DATABASE_URL=sqlite:////home/ubuntu/iot-data/iot.db

# ── 服务 ────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8005

# DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# CORS 允许的来源。开发阶段放开；上线前收窄到前端的实际域名。
CORS_ALLOW_ORIGINS=*

# ── 入库策略 ────────────────────────────────────────────────────
# clock=="boot" 的行（ts 是开机毫秒、不是 Unix 时间）要不要入库。
#
# 默认 true。为什么不是 false：如果设备侧 CONFIG_NTP_SERVER 留空
# （那是受支持的用法），**所有**报文都是 boot——丢弃的话数据库会一直
# 是空的，而系统看起来一切正常，这是最难查的一类故障。
# 入库之后由仓储层默认只返回 unix 行，忘写过滤在代码结构上不可能。
PERSIST_BOOT_ROWS=true

# 遥测保留天数。0 = 不清理（开发阶段先攒数据）。
# 注意清理语句必须带 clock='unix' 条件，否则会把 ts 只有几千的 boot 行全删掉。
TELEMETRY_RETENTION_DAYS=0
