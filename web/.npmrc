# npm 配置。
#
# ★ 用国内镜像：容器里构建时也要走它（容器的 DNS 和 WSL 相同，
#   实测 registry.npmmirror.com 可达，registry.npmjs.org 也通但慢）。
registry=https://registry.npmmirror.com

# ★ save-exact：装包时不要自动加 ^。
#
#   与后端 requirements.txt 用 == 而不是 >= 是同一个理由：
#   这个工程要长期跑，不钉死的话半年后 npm install 会拉到
#   不兼容的新版本，而症状是构建期或运行期才暴露。
#   钉死之后升级变成一次显式的动作。
save-exact=true

# 构建日志里显示进度条会刷屏，容器日志里很难看
progress=false
fund=false
audit=false
