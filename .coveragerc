# coverage.py 的配置。
#
# 为什么单独一个文件而不是塞进 pytest.ini：
#   pytest.ini 是 pytest 的，coverage.py 只认 .coveragerc / pyproject.toml /
#   setup.cfg。混着放会让人以为改 pytest.ini 就能改覆盖率行为。

[run]
source = app

# ★ 不排除 app/ai/。
#
#   它是 Phase 8 才实现的占位，现在只有常量和 raise NotImplementedError——
#   按"未实现所以不统计"排除掉，覆盖率数字会好看，但那是自欺：
#   占位代码同样是代码，它的契约（"调用即抛异常"）一样需要被锁住。
#   实际做法是给它写契约测试（tests/test_ai_placeholders.py），
#   现在它是 100%。

[report]
# ★ 覆盖率门槛。
#
#   低于它 pytest 直接失败。没有门槛的话，覆盖率只会单向下滑——
#   每次加功能都"先不写测试"，而没有任何机制会提醒你。
#
#   取 75 是计划里的验收值，而当前实测约 96%，留了足够余量：
#   门槛的意义是拦住"明显退化"，不是逼着每次提交都补测试。
#   （门槛定得贴着当前值的话，任何一次重构都会被它挡住，
#     最后大家会习惯性地调低它——那还不如不设。）
fail_under = 75

# 报告里列出没覆盖到的行号。光看百分比不知道缺在哪。
show_missing = True

# 覆盖率是四舍五入到整数的，别因为 74.6% 显示成 75% 而误判。
precision = 1
